{
	"name": "yanki",
	"version": "3.0.0",
	"description": "CLI tool and TypeScript library to turn Markdown into Anki flashcards.",
	"keywords": [
		"anki",
		"flashcards",
		"spaced-repetition",
		"anki-connect",
		"ankiconnect",
		"markdown",
		"cli",
		"sync",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/yanki",
	"bugs": "https://github.com/kitschpatrol/yanki/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/yanki.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		},
		"./standalone": {
			"types": "./dist/standalone/index.d.ts",
			"import": "./dist/standalone/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"jsdelivr": "./dist/standalone/index.js",
	"unpkg": "./dist/standalone/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"yanki": "dist/bin/cli.js"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsdown && attw -P --profile esm-only && publint",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"coverage": "vitest run --coverage",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"@shikijs/langs": "^4.5.0",
		"@shikijs/rehype": "^4.5.0",
		"@shikijs/themes": "^4.5.0",
		"@sindresorhus/fnv1a": "^3.1.0",
		"@sindresorhus/slugify": "^3.0.1",
		"@stdlib/assert-is-absolute-path": "^0.2.3",
		"@types/hast": "^3.0.5",
		"@types/lodash-es": "^4.17.12",
		"@types/mdast": "^4.0.4",
		"@types/node": "~22.18.13",
		"@types/unist": "^3.0.3",
		"@types/yargs": "^17.0.35",
		"crypto-hash": "^4.0.1",
		"deepmerge-ts": "^8.0.2",
		"filenamify": "6.0.0",
		"globby": "^16.2.4",
		"hast-util-to-text": "^4.0.2",
		"linkedom": "^0.18.13",
		"mdast-util-from-markdown": "^2.1.0",
		"micromark-util-sanitize-uri": "^2.0.1",
		"micromark-util-types": "^2.0.3",
		"nanoid": "^6.0.1",
		"path-browserify-esm": "^1.0.6",
		"picocolors": "^1.1.1",
		"plur": "^6.0.0",
		"pretty-ms": "^9.3.1",
		"rehype-format": "^5.0.1",
		"rehype-parse": "^9.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-breaks": "^4.0.0",
		"remark-denden-ruby": "^0.3.1",
		"remark-flexible-markers": "^1.3.6",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-github-beta-blockquote-admonitions": "^3.1.2",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.5.0",
		"slash": "^5.1.0",
		"sort-keys": "^6.0.1",
		"strip-ansi": "^7.2.0",
		"type-fest": "^5.10.0",
		"uint8array-extras": "^1.6.0",
		"unified": "^11.0.5",
		"unist-builder": "^4.0.0",
		"unist-util-visit": "^5.1.0",
		"untildify": "^6.0.0",
		"yaml": "^2.9.1",
		"yanki-connect": "^4.0.12",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.12.1",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"brewpub": "^0.5.0",
		"bumpp": "^12.3.0",
		"execa": "^10.0.1",
		"mdat-plugin-cli-help": "^3.4.0",
		"playwright": "^1.63.0",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^22.18.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.16.0"
		}
	}
}
